[Unit]
StartLimitIntervalSec=10s
StartLimitBurst=20
Description=Keimirror privacy-safe project status snapshot
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /opt/keimirror-telemetry/collector.py --config /etc/keimirror-telemetry/config.json --state-dir /var/lib/keimirror-telemetry --output /var/lib/keimirror-telemetry/public/snapshot.json
TimeoutStartSec=12s
CPUQuota=100%
MemoryMax=256M
PrivateTmp=no
ReadOnlyPaths=/tmp /var/tmp
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
StateDirectory=keimirror-telemetry
StateDirectoryMode=0755
UMask=0022
